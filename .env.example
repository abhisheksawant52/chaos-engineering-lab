# Path to the kubeconfig used to reach the target cluster.
KUBECONFIG=~/.kube/config

# Namespace experiments are applied to.
NAMESPACE=chaos-testing

# Which chaos platform manifests target: litmus | chaos-mesh
CHAOS_ENGINE=chaos-mesh

# Base URL of the Prometheus used for steady-state hypothesis checks.
PROMETHEUS_URL=http://prometheus:9090

# Root directory holding experiment manifests.
EXPERIMENTS_DIR=experiments

# Root log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
